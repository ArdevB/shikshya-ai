# Only needed when running this service by itself, such as in deployment. `pnpm dev` takes these
# from apps/api/.env. INTERNAL_KEY must match the API's.
INTERNAL_KEY=change-me-internal-key-at-least-32-characters

# Google Gemini, for quiz generation. Get a key at https://aistudio.google.com.
# The free tier may use what you send to improve Google's products and forbids personal data.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
