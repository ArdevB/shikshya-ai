# Copy to apps/web/.env if the API is not on the same origin.
# In development Vite proxies /api to http://localhost:4000, so the default works.
VITE_API_URL=/api/v1
# Where live notifications connect. Empty means this site's own address, which suits development.
# In production, the API's own address: Vercel's forwarding cannot carry WebSockets.
VITE_SOCKET_URL=
