# Copy to apps/api/.env for local development.

NODE_ENV=development
PORT=4000

# Postgres. For Neon, use its direct connection string (no "-pooler" in the host), and add
# &connect_timeout=15&connection_limit=8&pool_timeout=30 to the end. A sleeping database takes time
# to wake, and across the network a smaller pool avoids long stalls while new connections open.
# This default is for the optional local databases, `pnpm db:up` and `pnpm db:local`.
DATABASE_URL=postgresql://shikshya:shikshya@localhost:5432/shikshya

# Sign tokens with long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# The web app's origin, allowed by CORS.
WEB_ORIGIN=http://localhost:5173

# Where uploaded files are kept, relative to apps/api. Phase 5 adds cloud storage.
UPLOAD_DIR=uploads

# The address payment gateways send the browser back to.
API_PUBLIC_URL=http://localhost:4000

# eSewa. These are eSewa's published test values. Production needs your own.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti. Get the sandbox key from https://test-admin.khalti.com (it is called live_secret_key
# there). Production uses https://khalti.com/api/v2 and a key from admin.khalti.com.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# Email. Leave SMTP_HOST empty to log emails instead of sending them.
# To see real emails locally, run Mailpit and use SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Shikshya <no-reply@shikshya.test>

# Extra Chrome flags for PDF generation, for example --no-sandbox inside a container.
PUPPETEER_ARGS=

# Google Gemini, for the assistant and college-rules search. Get a key at
# https://aistudio.google.com. Without one, the AI features say they are not set up.
# The free tier may use what you send to improve Google's products and forbids personal data,
# so use it with the fake demo data only. Real student data needs billing enabled.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# The Python AI service, for risk prediction, quiz generation and the timetable generator.
# `pnpm dev` hands it these settings. INTERNAL_KEY is the secret between the two: generate one as above.
AI_SERVICE_URL=http://localhost:8000
INTERNAL_KEY=change-me-internal-key-at-least-32-characters
