// Shikshya database schema.
// Dates are stored in UTC and displayed in Asia/Kathmandu. Money, from Phase 3, is integer paisa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
}

enum GradingScheme {
  TU_GPA
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ---------- Users and auth ----------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  // Set for accounts created with a temporary password, cleared when they choose their own.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  // Wrong passwords in a row, and when a lock from too many of them ends.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  teacher                 Teacher?
  student                 Student?
  parent                  Parent?
  auditLogs               AuditLog[]
  sessionsTaken           AttendanceSession[]
  marksEntered            Mark[]
  assignments             Assignment[]             @relation("AssignmentCreator")
  gradedWork              Submission[]             @relation("SubmissionGrader")
  materials               Material[]               @relation("MaterialCreator")
  notices                 Notice[]                 @relation("NoticeCreator")
  noticeReads             NoticeRead[]
  events                  Event[]                  @relation("EventCreator")
  paymentsRecorded        Payment[]                @relation("PaymentRecorder")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  chatConversations       ChatConversation[]
  policyDocuments         PolicyDocument[]
  quizzesCreated          Quiz[]
  riskReviews             RiskPrediction[]
  aiCalls                 AiCallLog[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Academic structure ----------

model Department {
  id   String @id @default(cuid())
  name String
  code String @unique

  programs Program[]
  teachers Teacher[]
}

model Program {
  id                String        @id @default(cuid())
  departmentId      String
  name              String
  code              String        @unique
  durationSemesters Int
  gradingScheme     GradingScheme @default(TU_GPA)

  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semesters     Semester[]
  courses       Course[]
  students      Student[]
  notices       Notice[]
  events        Event[]
  feeStructures FeeStructure[]

  @@index([departmentId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  semesters     Semester[]
  feeStructures FeeStructure[]
}

model Semester {
  id             String   @id @default(cuid())
  programId      String
  academicYearId String
  number         Int
  startDate      DateTime
  endDate        DateTime

  program      Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections     Section[]
  timetable    TimetableEntry[]
  exams        Exam[]
  results      Result[]
  invoices     Invoice[]

  @@unique([programId, academicYearId, number])
  @@index([programId])
  @@index([academicYearId])
}

model Section {
  id         String @id @default(cuid())
  semesterId String
  name       String

  semester        Semester         @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  offerings       CourseOffering[]
  enrollments     Enrollment[]
  currentStudents Student[]
  notices         Notice[]
  events          Event[]

  @@unique([semesterId, name])
  @@index([semesterId])
}

model Course {
  id             String  @id @default(cuid())
  programId      String
  code           String
  title          String
  creditHours    Int
  semesterNumber Int
  hasPractical   Boolean @default(false)

  program       Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  offerings     CourseOffering[]
  resultCourses ResultCourse[]

  @@unique([programId, code])
  @@index([programId])
}

/// Who teaches which course to which section.
model CourseOffering {
  id        String @id @default(cuid())
  courseId  String
  sectionId String
  teacherId String

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  teacher            Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  examSubjects       ExamSubject[]
  assignments        Assignment[]
  materials          Material[]
  riskPredictions    RiskPrediction[]
  quizzes            Quiz[]

  /// Periods a week. Left empty, the timetable generator works them out from the course.
  weeklyTheoryPeriods Int?
  weeklyLabPeriods    Int?

  @@unique([courseId, sectionId])
  @@index([courseId])
  @@index([sectionId])
  @@index([teacherId])
}

// ---------- People ----------

model Teacher {
  id           String @id @default(cuid())
  userId       String @unique
  employeeCode String @unique
  departmentId String
  designation  String

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  offerings      CourseOffering[]
  unavailability TeacherUnavailability[]

  @@index([departmentId])
}

model Student {
  id                 String    @id @default(cuid())
  userId             String    @unique
  rollNumber         String    @unique
  registrationNumber String?   @unique
  programId          String
  currentSectionId   String
  admissionDate      DateTime
  dateOfBirth        DateTime?
  address            String?
  guardianName       String?
  guardianPhone      String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program           Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  currentSection    Section            @relation(fields: [currentSectionId], references: [id], onDelete: Restrict)
  parents           ParentStudent[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  marks             Mark[]
  results           Result[]
  submissions       Submission[]
  invoices          Invoice[]

  riskPredictions RiskPrediction[]
  quizAttempts    QuizAttempt[]

  @@index([programId])
  @@index([currentSectionId])
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
}

/// Links parents to their children (many-to-many).
model ParentStudent {
  parentId  String
  studentId String
  relation  String

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  sectionId String
  status    EnrollmentStatus @default(ACTIVE)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, sectionId])
  @@index([studentId])
  @@index([sectionId])
}

// ---------- Attendance ----------

model AttendanceSession {
  id               String   @id @default(cuid())
  courseOfferingId String
  date             DateTime @db.Date
  // 0 means "no specific period", so the unique rule below still applies to those sessions.
  period           Int      @default(0)
  takenById        String
  createdAt        DateTime @default(now())

  courseOffering CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  takenBy        User               @relation(fields: [takenById], references: [id], onDelete: Restrict)
  records        AttendanceRecord[]

  @@unique([courseOfferingId, date, period])
  @@index([courseOfferingId, date])
  @@index([takenById])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  remark    String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ---------- Audit ----------

model AuditLog {
  id        String   @id @default(cuid())
  /// Empty when the system did it: a gateway callback or a scheduled job.
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([actorId])
}

// ---------- Phase 2: timetable ----------

enum RoomType {
  CLASSROOM
  LAB
  HALL
}

model Room {
  id       String   @id @default(cuid())
  name     String   @unique
  capacity Int
  type     RoomType @default(CLASSROOM)

  entries TimetableEntry[]
}

model TimeSlot {
  id        String  @id @default(cuid())
  /// 0 is Sunday, 6 is Saturday.
  dayOfWeek Int
  /// "HH:mm" in Nepal time. Text, because a class time is not tied to any date.
  startTime String
  endTime   String
  label     String?

  entries               TimetableEntry[]
  teacherUnavailability TeacherUnavailability[]

  @@unique([dayOfWeek, startTime])
}

model TimetableEntry {
  id               String @id @default(cuid())
  courseOfferingId String
  roomId           String
  timeSlotId       String
  semesterId       String

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  room           Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  timeSlot       TimeSlot       @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  semester       Semester       @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  // Teacher and section clashes run through the offering, so timetable.service.ts checks those.
  @@unique([roomId, timeSlotId, semesterId])
  @@index([courseOfferingId])
  @@index([timeSlotId])
  @@index([semesterId])
}

// ---------- Phase 2: exams and results ----------

enum ExamType {
  INTERNAL
  PRACTICAL
  FINAL
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
}

model Exam {
  id          String   @id @default(cuid())
  semesterId  String
  name        String
  type        ExamType
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(false)

  semester Semester      @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  subjects ExamSubject[]

  @@index([semesterId])
}

model ExamSubject {
  id               String    @id @default(cuid())
  examId           String
  courseOfferingId String
  fullMarks        Decimal   @db.Decimal(6, 2)
  passMarks        Decimal   @db.Decimal(6, 2)
  date             DateTime? @db.Date

  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  marks          Mark[]

  @@unique([examId, courseOfferingId])
  @@index([courseOfferingId])
}

model Mark {
  id            String   @id @default(cuid())
  examSubjectId String
  studentId     String
  marksObtained Decimal? @db.Decimal(6, 2)
  isAbsent      Boolean  @default(false)
  enteredById   String
  updatedAt     DateTime @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy   User        @relation(fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
}

/// Kept in the database rather than in code, so it can be adjusted without a release.
model GradeScale {
  id         String        @id @default(cuid())
  scheme     GradingScheme @default(TU_GPA)
  minPercent Decimal       @db.Decimal(5, 2)
  /// Exclusive, except for the top band.
  maxPercent Decimal       @db.Decimal(5, 2)
  grade      String
  gradePoint Decimal       @db.Decimal(3, 2)

  @@unique([scheme, grade])
}

model Result {
  id           String       @id @default(cuid())
  studentId    String
  semesterId   String
  gpa          Decimal      @db.Decimal(3, 2)
  totalCredits Int
  status       ResultStatus
  publishedAt  DateTime?

  student  Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester       @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  courses  ResultCourse[]

  @@unique([studentId, semesterId])
  @@index([semesterId])
}

model ResultCourse {
  id          String  @id @default(cuid())
  resultId    String
  courseId    String
  percent     Decimal @db.Decimal(5, 2)
  grade       String
  gradePoint  Decimal @db.Decimal(3, 2)
  creditHours Int

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([resultId, courseId])
  @@index([courseId])
}

// ---------- Phase 2: assignments and materials ----------

model Assignment {
  id                String    @id @default(cuid())
  courseOfferingId  String
  title             String
  description       String
  dueAt             DateTime
  maxMarks          Decimal   @db.Decimal(6, 2)
  allowLate         Boolean   @default(false)
  attachments       Json      @default("[]")
  createdById       String
  createdAt         DateTime  @default(now())
  dueReminderSentAt DateTime?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions    Submission[]

  @@index([courseOfferingId])
  @@index([dueAt])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime  @default(now())
  files        Json      @default("[]")
  text         String?
  isLate       Boolean   @default(false)
  marks        Decimal?  @db.Decimal(6, 2)
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Material {
  id               String   @id @default(cuid())
  courseOfferingId String
  title            String
  description      String?
  files            Json     @default("[]")
  createdById      String
  createdAt        DateTime @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("MaterialCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([courseOfferingId])
}

// ---------- Phase 2: notices and events ----------

enum Audience {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  PROGRAM
  SECTION
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    Audience  @default(ALL)
  programId   String?
  sectionId   String?
  isPinned    Boolean   @default(false)
  publishAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  /// When its notification went out. Scheduled notices wait for the job to send it.
  notifiedAt  DateTime?

  program   Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)
  section   Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User         @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reads     NoticeRead[]

  @@index([publishAt])
  @@index([programId])
  @@index([sectionId])
}

model NoticeRead {
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  audience    Audience @default(ALL)
  programId   String?
  sectionId   String?
  createdById String

  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([startAt])
}

// ---------- Phase 3: fees and payments. All money is integer paisa. ----------

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum FineType {
  FIXED
  PER_DAY
}

enum PaymentMethod {
  ESEWA
  KHALTI
  CASH
  BANK
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model FeeHead {
  id   String @id @default(cuid())
  name String
  code String @unique

  structureItems FeeStructureItem[]
  invoiceItems   InvoiceItem[]
}

model FeeStructure {
  id             String @id @default(cuid())
  programId      String
  semesterNumber Int
  academicYearId String

  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  items        FeeStructureItem[]
  invoices     Invoice[]

  @@unique([programId, semesterNumber, academicYearId])
}

model FeeStructureItem {
  id             String @id @default(cuid())
  feeStructureId String
  feeHeadId      String
  amountPaisa    Int

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([feeStructureId, feeHeadId])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  studentId      String
  semesterId     String
  /// Set for invoices generated in bulk. The unique rule below makes generating twice harmless.
  feeStructureId String?
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(UNPAID)
  totalPaisa     Int
  paidPaisa      Int           @default(0)
  finePaisa      Int           @default(0)
  discountPaisa  Int           @default(0)
  createdAt      DateTime      @default(now())

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester     Semester      @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([studentId, feeStructureId])
  @@index([studentId])
  @@index([semesterId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  feeHeadId   String
  description String
  amountPaisa Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model FineRule {
  id          String   @id @default(cuid())
  name        String
  type        FineType
  amountPaisa Int
  graceDays   Int      @default(0)
  maxPaisa    Int?
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  amountPaisa    Int
  method         PaymentMethod
  status         PaymentStatus @default(INITIATED)
  gatewayRef     String?
  gatewayPayload Json?
  receiptNumber  String?       @unique
  paidAt         DateTime?
  recordedById   String?
  createdAt      DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
}

/// Hands out the next number for invoices and receipts, one at a time, inside a transaction.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------- Phase 3: notifications and settings ----------

enum NotificationChannel {
  EMAIL
  IN_APP
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A missing row means enabled, so people get everything until they opt out.
model NotificationPreference {
  userId  String
  channel NotificationChannel
  type    String
  enabled Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel, type])
}

/// A single row holding the institution's details, used on every PDF.
model InstitutionSettings {
  id            String  @id @default("default")
  name          String
  address       String
  phone         String  @default("")
  email         String  @default("")
  principalName String  @default("")
  logoDataUrl   String?
}

// ---------- Phase 4: AI ----------

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatConversation {
  id              String   @id @default(cuid())
  userId          String
  title           String
  /// Lets Gemini continue from its last turn. Empty, or expired, means replaying the transcript.
  providerStateId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        Json
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PolicyDocument {
  id           String   @id @default(cuid())
  title        String
  file         Json
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks     PolicyChunk[]

  @@index([createdAt])
}

model PolicyChunk {
  id         String                      @id @default(cuid())
  documentId String
  position   Int
  content    String
  /// Only exists where pgvector does. The migration leaves it out of the throwaway test database.
  embedding  Unsupported("vector(768)")?

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model RiskPrediction {
  id               String    @id @default(cuid())
  studentId        String
  courseOfferingId String
  probability      Float
  level            RiskLevel
  /// The reasons, already in plain language.
  factors          Json
  computedAt       DateTime
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?
  /// When the student last got a supportive nudge, so they get at most one a week.
  nudgedAt         DateTime?

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([studentId, courseOfferingId])
  @@index([courseOfferingId, level])
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

model Quiz {
  id               String     @id @default(cuid())
  courseOfferingId String
  title            String
  status           QuizStatus @default(DRAFT)
  /// The notes it was written from, so one question can be regenerated later.
  sourceText       String
  opensAt          DateTime?
  closesAt         DateTime?
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime   @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]

  @@index([courseOfferingId, status])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  quizId        String
  position      Int
  type          QuizQuestionType
  question      String
  options       Json?
  correctAnswer String
  explanation   String
  difficulty    QuizDifficulty
  sourceSnippet String
  approved      Boolean          @default(false)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, position])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, studentId])
}

model QuizAnswer {
  id         String    @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  /// Null until a teacher marks a short answer.
  isCorrect  Boolean?
  gradedById String?
  gradedAt   DateTime?

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model TeacherUnavailability {
  teacherId  String
  timeSlotId String

  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([teacherId, timeSlotId])
}

/// Every call to an AI model, for cost and troubleshooting. Holds no prompts or replies.
model AiCallLog {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  model     String
  tokensIn  Int?
  tokensOut Int?
  latencyMs Int
  succeeded Boolean
  errorCode String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([feature, createdAt])
}
